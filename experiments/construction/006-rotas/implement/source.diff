index e69de29..31d4d18 100644
--- a/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamCatalog.java
+++ b/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamCatalog.java
@@ -0,0 +1,52 @@
+package pt.uminho.esr.ott.streaming;
+
+import java.util.*;
+import pt.uminho.esr.ott.routing.*;
+
+/** Owner-published projections. Expiry of a view never mutates the routing domain. */
+public final class StreamCatalog {
+    public record Entry(StreamInfo info, RouteState state, Optional<RouteMetric> metric,
+            Optional<RoutingTable.SessionKey> knownUpstream, boolean localOffer, OptionalLong remainingNanos) {
+        public Entry {
+            Objects.requireNonNull(info); Objects.requireNonNull(state); Objects.requireNonNull(metric);
+            Objects.requireNonNull(knownUpstream); Objects.requireNonNull(remainingNanos);
+            if (localOffer == remainingNanos.isPresent() || remainingNanos.isPresent() && remainingNanos.orElseThrow() < 1
+                    || state != (metric.isPresent() ? RouteState.INACTIVE : RouteState.UNAVAILABLE))
+                throw new IllegalArgumentException("Inconsistent catalog entry");
+        }
+    }
+    public record Snapshot(long capturedAtNanos, Map<UUID, Entry> entries) {
+        public Snapshot {
+            Objects.requireNonNull(entries);
+            if (entries.size() > 16_384) throw new IllegalArgumentException("Catalog capacity");
+            for (var entry : entries.entrySet())
+                if (!entry.getKey().equals(entry.getValue().info().streamId())) throw new IllegalArgumentException("Catalog key");
+            entries = Map.copyOf(entries);
+        }
+        public Snapshot visibleAt(long now) {
+            long age = now - capturedAtNanos;
+            if (age < 0) throw new IllegalArgumentException("Monotonic horizon");
+            var visible = new LinkedHashMap<UUID, Entry>();
+            entries.forEach((id, e) -> {
+                if (e.localOffer()) visible.put(id, e);
+                else if (e.remainingNanos().orElseThrow() > age)
+                    visible.put(id, new Entry(e.info(), e.state(), e.metric(), e.knownUpstream(), false,
+                            OptionalLong.of(e.remainingNanos().orElseThrow() - age)));
+            });
+            return new Snapshot(now, visible);
+        }
+    }
+    private final int capacity;
+    private volatile Snapshot view = new Snapshot(0, Map.of());
+    public StreamCatalog(int capacity) {
+        if (capacity < 1 || capacity > 16_384) throw new IllegalArgumentException("Catalog capacity");
+        this.capacity = capacity;
+    }
+    /** Only the composing RoutingService calls this mutation, on its serial owner. */
+    public void replace(Snapshot snapshot) {
+        Objects.requireNonNull(snapshot);
+        if (snapshot.entries().size() > capacity) throw new IllegalArgumentException("Catalog capacity");
+        view = snapshot;
+    }
+    public Snapshot snapshot() { return view; }
+}
diff --git a/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamInfo.java b/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamInfo.java
index e69de29..598f6c8 100644
--- a/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamInfo.java
+++ b/Projeto/src/main/java/pt/uminho/esr/ott/streaming/StreamInfo.java
@@ -0,0 +1,35 @@
+package pt.uminho.esr.ott.streaming;
+
+import java.nio.CharBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.Objects;
+import java.util.UUID;
+import pt.uminho.esr.ott.protocol.ControlMessage;
+
+/** Immutable source metadata; titles are content, never stream identities. */
+public record StreamInfo(UUID streamId, String serverId, String title, int codec, int fps, UUID serverEpoch) {
+    public StreamInfo {
+        Objects.requireNonNull(streamId); Objects.requireNonNull(serverId);
+        Objects.requireNonNull(title); Objects.requireNonNull(serverEpoch);
+        if (!serverId.matches("[A-Za-z0-9_-]{1,32}") || codec != 1 || fps < 1 || fps > 60
+                || title.isEmpty() || title.codePointCount(0, title.length()) > 128 || title.indexOf(0) >= 0)
+            throw new IllegalArgumentException("Invalid stream metadata");
+        try {
+            if (StandardCharsets.UTF_8.newEncoder().onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT).encode(CharBuffer.wrap(title)).remaining() > 512)
+                throw new IllegalArgumentException("Title exceeds UTF-8 limit");
+        } catch (CharacterCodingException e) { throw new IllegalArgumentException("Invalid Unicode title", e); }
+    }
+    public static StreamInfo fromWire(ControlMessage.StreamInfo info) {
+        Objects.requireNonNull(info);
+        return new StreamInfo(info.streamId(), info.serverId(), info.title(), info.codec(), info.fps(), info.serverEpoch());
+    }
+    public ControlMessage.StreamInfo toWire() {
+        return new ControlMessage.StreamInfo(streamId, serverId, title, codec, fps, serverEpoch);
+    }
+    public boolean sameMetadata(StreamInfo other) {
+        return title.equals(other.title) && codec == other.codec && fps == other.fps;
+    }
+}
