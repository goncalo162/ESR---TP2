    static final class Owner implements NeighborManager.SerialOwner {
        final ArrayDeque<Runnable> events=new ArrayDeque<>();final List<Runnable> hooks=new ArrayList<>();boolean inside,stopped;
        public int capacity(){return 4096;}public boolean isOwnerThread(){return inside;}
        public boolean offer(Runnable r){if(stopped)return false;if(events.size()==capacity()){fail(new IllegalStateException("manual owner full"));return false;}events.addLast(r);return true;}
        public NeighborManager.Registration onStop(Runnable r){hooks.add(r);return ()->hooks.remove(r);}
        public void fail(Throwable error){requestClose();}
        public void requestClose(){if(stopped)return;stopped=true;events.clear();run(()->{for(var r:List.copyOf(hooks))r.run();});}
        public boolean awaitTermination(Duration d){return stopped;}public void close(){requestClose();}
        void run(Runnable r){boolean old=inside;inside=true;try{r.run();}finally{inside=old;}}
        void drain(){int budget=50000;while(!events.isEmpty()){if(--budget==0)throw new AssertionError("owner flood");run(events.removeFirst());}}
    }
    static final class Scheduler implements RoutingService.Scheduler {
        final AtomicLong time;final List<Job> jobs=new ArrayList<>();boolean stopped;
        final class Job implements RoutingService.Ticket {final Runnable action;final long at;Job(Runnable a,long delay){action=a;at=time.get()+delay;}public void cancel(){jobs.remove(this);}}
        Scheduler(AtomicLong time){this.time=time;}
        public RoutingService.Ticket schedule(Runnable r,long delay){if(stopped||jobs.size()>=2)throw new RejectedExecutionException("manual timers");var job=new Job(r,delay);jobs.add(job);return job;}
        public void requestClose(){stopped=true;jobs.clear();}public boolean awaitTermination(Duration d){return jobs.isEmpty();}public int physicalJobs(){return jobs.size();}
        boolean fire(){for(var job:List.copyOf(jobs))if(time.get()-job.at>=0){jobs.remove(job);job.action.run();return true;}return false;}
    }
    record Sent(Neighbor.Session peer,ControlMessage message){}
    static final class ModelNode implements AutoCloseable {
        final String id;final UUID identity;final AtomicLong clock;final Owner owner=new Owner();final Scheduler scheduler;final RoutingService router;
        final Map<String,Neighbor.Session> peers=new HashMap<>();final List<Sent> sent=new ArrayList<>();BiConsumer<Neighbor.Session,ControlMessage> delivery;
        ModelNode(String id,boolean source,AtomicLong clock){
            this.id=id;identity=instance(id);this.clock=clock;scheduler=new Scheduler(clock);
            router=new RoutingService(config(id,source?NodeRole.SERVER:NodeRole.RELAY,19001,19101,19000),identity,owner,(peer,message)->{
                sent.add(new Sent(peer,message));if(delivery!=null)delivery.accept(peer,message);return CompletableFuture.completedStage(Connection.SendResult.ACCEPTED);
            },event->{if(event.fatal())throw new AssertionError("routing local failure: "+event.reason());},clock::get,scheduler);
            act(router::start);
        }
        void act(Runnable action){owner.run(action);owner.drain();}
        Neighbor.Session up(String peer,UUID peerInstance,long cost){
            var s=new Neighbor.Session(peer,peerInstance,UUID.randomUUID(),new ControlMessage.Endpoint(peer,peerInstance,"127.0.0.1",19002,19102,NodeRole.RELAY));peers.put(peer,s);
            act(()->router.onNeighborEvent(new NeighborManager.NeighborUp(s)));
            act(()->router.onMetrics(new NetworkMonitor.Updated(new LinkMetrics(s,LinkMetrics.State.MEASURED,OptionalDouble.of(cost),OptionalLong.of(cost),1,false,OptionalLong.of(clock.get()),0))));return s;
        }
        void receive(String peer,ControlMessage message){act(()->router.onNeighborEvent(new NeighborManager.Received(peers.get(peer),message)));}
        void ad(String peer,UUID epoch,long seq,long cost,String title){
            var s=peers.get(peer);receive(peer,new ControlMessage(MessageType.STREAM_ANNOUNCE,UUID.randomUUID(),peer,s.instanceId(),new ControlMessage.Announcement(new ControlMessage.StreamInfo(A,"S1",title,1,25,epoch),seq,cost,List.of("S1",peer))));
        }
        Route route(UUID stream){return router.snapshot().routes().get(stream);}
        void expireTimers(){int budget=50000;while(scheduler.fire()){if(--budget==0)throw new AssertionError("timer flood");owner.drain();}owner.drain();}
        public void close(){router.requestClose();owner.drain();if(!router.awaitTermination(Duration.ofSeconds(1)))throw new AssertionError("model cleanup");owner.close();}
    }
    record Frame(String from,String to,ControlMessage message){}
    static final class Graph implements AutoCloseable {
        final AtomicLong clock=new AtomicLong();final Map<String,ModelNode> nodes=new LinkedHashMap<>();final ArrayDeque<Frame> wire=new ArrayDeque<>();final List<Long> arrivals=new ArrayList<>();int messages;
        Graph(){for(String id:List.of("S1","S2","R1","R2","C")){
            var node=new ModelNode(id,id.startsWith("S"),clock);nodes.put(id,node);node.delivery=(peer,message)->{messages++;wire.addLast(new Frame(id,peer.nodeId(),message));};
        }}
        void edge(String a,String b,long cost){var x=nodes.get(a);var y=nodes.get(b);x.up(b,y.identity,cost);y.up(a,x.identity,cost);}
        void pump(){int budget=50000;while(!wire.isEmpty()){
            if(--budget==0)throw new AssertionError("wire flood");var frame=wire.removeFirst();var target=nodes.get(frame.to);target.receive(frame.from,frame.message);
            if(frame.to.equals("C")&&frame.message.payload() instanceof ControlMessage.Announcement ann&&ann.stream().streamId().equals(A)){
                var route=target.route(A);if(route!=null&&route.selectedMetric().isPresent())arrivals.add(route.selectedMetric().orElseThrow().costMicros());
            }
        }}
        void tick(long ms){clock.addAndGet(ms*1_000_000);for(var n:nodes.values())n.expireTimers();pump();}
        public void close(){for(var node:nodes.values())node.close();}
        boolean closed(){return nodes.values().stream().allMatch(n->n.router.snapshot().diagnostics().phase()==RoutingService.Phase.STOPPED&&n.scheduler.physicalJobs()==0);}
    }
    static long cost(ModelNode node,UUID stream){return node.route(stream).selectedMetric().orElseThrow().costMicros();}
    static boolean immutable(Map<?,?> map){try{map.clear();return false;}catch(UnsupportedOperationException expected){return true;}}
    static void until(BooleanSupplier p,String condition)throws Exception{
        long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(15);
        while(!p.getAsBoolean()){if(System.nanoTime()-deadline>=0)throw new AssertionError("deadline: "+condition);Thread.sleep(10);}
    }
    static final class RealGroup implements AutoCloseable {
        final Map<String,OverlayNode> nodes=new LinkedHashMap<>();final List<Integer> controls=new ArrayList<>(),data=new ArrayList<>();
        final ConcurrentHashMap<UUID,Long> sequences=new ConcurrentHashMap<>();final AtomicReference<ControlMessage> firstAnnounce=new AtomicReference<>();
        BootstrapServer bootstrap;int bootstrapPort;boolean closed,terminated;
        RealGroup()throws Exception{
            LIVE.set(this);var reserved=new ArrayList<ServerSocket>();
            try{
                for(int i=0;i<11;i++)reserved.add(new ServerSocket(0,1,InetAddress.getByName("127.0.0.1")));
                bootstrapPort=reserved.get(0).getLocalPort();for(int i=1;i<=5;i++)controls.add(reserved.get(i).getLocalPort());for(int i=6;i<=10;i++)data.add(reserved.get(i).getLocalPort());
            }finally{for(var socket:reserved)socket.close();}
            var ids=List.of("S1","S2","R1","R2","C");var graph=new LinkedHashMap<String,TopologyConfiguration.Node>();
            for(int i=0;i<ids.size();i++){
                String id=ids.get(i);Set<String> neighbors=id.startsWith("R")?Set.of("S1","S2","C"):Set.of("R1","R2");
                graph.put(id,new TopologyConfiguration.Node(id,"127.0.0.1",controls.get(i),data.get(i),role(id),neighbors));
            }
            bootstrap=new BootstrapServer(new NodeConfiguration(Path.of("manual-BOOT"),"BOOT",NodeRole.BOOTSTRAP,"127.0.0.1","127.0.0.1",bootstrapPort,0,Optional.empty(),Optional.of(Path.of("manual-graph")),Optional.empty(),Optional.empty(),Optional.of(new TopologyConfiguration(Path.of("manual-graph"),graph)),List.of(),RuntimeConfiguration.defaults()));
            for(int i=0;i<ids.size();i++){
                String id=ids.get(i);nodes.put(id,new OverlayNode(config(id,role(id),controls.get(i),data.get(i),bootstrapPort),UUID.randomUUID(),event->{
                    if(id.equals("C")&&event instanceof NeighborManager.Received received&&received.message().payload() instanceof ControlMessage.Announcement ann){
                        firstAnnounce.compareAndSet(null,received.message());sequences.merge(ann.stream().streamId(),ann.announceSeq(),Math::max);
                    }
                }));
            }
        }
        static NodeRole role(String id){return id.startsWith("S")?NodeRole.SERVER:id.equals("C")?NodeRole.CLIENT:NodeRole.RELAY;}
        void start()throws Exception{
            for(var n:nodes.values())n.start().toCompletableFuture().get(6,TimeUnit.SECONDS);
            until(()->nodes.get("C").routingSnapshot().catalog().entries().size()==4,"four real streams");
            until(()->nodes.get("C").routingSnapshot().routes().values().stream().filter(r->r.selectedMetric().isPresent()).count()==4,"four real costs");
        }
        Map<String,Map<String,Neighbor.Session>> sessions(){var copy=new LinkedHashMap<String,Map<String,Neighbor.Session>>();nodes.forEach((id,node)->copy.put(id,node.snapshot()));return Map.copyOf(copy);}
        boolean healthy(){return nodes.values().stream().allMatch(n->n.failure().isEmpty());}
        public synchronized void close(){
            if(closed)return;closed=true;boolean done=true;
            for(var node:nodes.values())try{node.requestShutdown(0,Duration.ofSeconds(3));}catch(RuntimeException e){done=false;}
            for(var node:nodes.values())try{done&=node.awaitTermination(Duration.ofSeconds(3));}catch(RuntimeException e){done=false;}
            if(bootstrap!=null)try{bootstrap.close();}catch(RuntimeException e){done=false;}
            terminated=done;
        }
        boolean portsFree(){
            for(int port:controls)try(var s=new ServerSocket()){s.setReuseAddress(true);s.bind(new InetSocketAddress("127.0.0.1",port));}catch(IOException e){return false;}
            for(int port:data)try(var s=new DatagramSocket(null)){s.setReuseAddress(false);s.bind(new InetSocketAddress("127.0.0.1",port));}catch(IOException e){return false;}
            try(var s=new ServerSocket()){s.setReuseAddress(true);s.bind(new InetSocketAddress("127.0.0.1",bootstrapPort));}catch(IOException e){return false;}return true;
        }
    }
