    public static void main(String[] args)throws Exception{
        interactive=args.length>0&&args[0].equals("--interactive");Path jar=Path.of(args[1]).toRealPath();
        Runtime.getRuntime().addShutdownHook(new Thread(()->{var group=LIVE.get();if(group!=null)group.close();},"manual-cleanup"));
        System.out.println("CODE_SOURCE="+RoutingService.class.getProtectionDomain().getCodeSource().getLocation());
        try{run(jar);if(checks!=EXPECTED)throw new AssertionError("check count");System.out.println("CHECK_COUNT="+checks);System.out.println("MANUAL_PASS");}
        catch(Throwable error){var group=LIVE.getAndSet(null);if(group!=null)group.close();System.out.println("CHECK_FAIL "+error);error.printStackTrace(System.out);System.out.println("CHECK_COUNT="+checks);System.out.println("MANUAL_FAIL");System.exit(1);}
    }
