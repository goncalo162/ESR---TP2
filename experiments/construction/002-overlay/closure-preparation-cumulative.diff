+        private void cleanup() {
+            if (cleaned) return;
+            cleaned = true;
+            for (var context : new ArrayList<>(contexts.values())) finish(context);
+            deadlines.close(); events.close();
+        }
+        int contextCount() { return contexts.size(); }
+    }
