+        }
+        private final Map<UUID, Context> contexts = new LinkedHashMap<>();
+        private boolean cleaned;
+        private long budget() { return plan.config.runtime().control().bootstrapQueryTimeout().toNanos(); }
+        private boolean expired(Context context) { return clock.getAsLong() - context.started >= budget(); }
+
+        void open(Channel channel) {
+            long started = clock.getAsLong();
+            if (!post(() -> {
+                var context = new Context(channel, started);
+                if (!channel.isOpen() || expired(context) || contexts.size() >= plan.options.maxConnections()
+                        || contexts.containsKey(channel.id())) { channel.close(); return; }
+                contexts.put(channel.id(), context);
+                long remaining = budget() - (clock.getAsLong() - started);
+                if (remaining <= 0) { finish(context); return; }
+                context.ticket = deadlines.schedule(() -> post(() -> {
+                    if (contexts.get(channel.id()) == context && expired(context)) finish(context);
+                }), remaining);
+            })) channel.close();
+        }
