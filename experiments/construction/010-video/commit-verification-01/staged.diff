++        assertArrayEquals(new byte[]{(byte) 0xaa}, value.payload());
++    }
++
++    @Test void U08_decoderOwnsPayloadAfterReceiveBufferReuse() throws Exception {
++        byte[] input = fixture("small");
++        StreamPacket packet = assertDoesNotThrow(() -> StreamPacket.decode(input));
++        assertNotNull(packet, "decode behavior is required before ownership can be verified");
++        input[64] = 0;
++        assertArrayEquals(new byte[]{0x41, 0x42, 0x43}, packet.payload());
++    }
++
++    @Test void U08_fragmentationOwnsPayloadAndReturnsImmutableList() {
++        byte[] original = {(byte) 0xaa};
++        List<StreamPacket> packets = StreamPacket.fragment(STREAM, SESSION, 0, 0, original);
++        assertEquals(1, packets.size());
++        original[0] = 0;
++        assertArrayEquals(new byte[]{(byte) 0xaa}, packets.getFirst().payload());
++        assertThrows(UnsupportedOperationException.class, () -> packets.add(packets.getFirst()));
++    }
++
++    @Test void U06_absentIdsAndPayloadAreRejectedExplicitly() {
++        assertThrows(IllegalArgumentException.class,
++                () -> new StreamPacket(null, SESSION, 0, 0, 1, 0, 1, new byte[1]));
++        assertThrows(IllegalArgumentException.class,
++                () -> new StreamPacket(STREAM, null, 0, 0, 1, 0, 1, new byte[1]));
++        assertThrows(IllegalArgumentException.class, () -> packet(0, 0, 1, 0, 1, null));
++        assertThrows(IllegalArgumentException.class,
++                () -> StreamPacket.fragment(STREAM, SESSION, 0, 0, null));
++        assertThrows(IllegalArgumentException.class,
++                () -> StreamPacket.fragment(null, SESSION, 0, 0, new byte[1]));
++        assertThrows(IllegalArgumentException.class,
++                () -> StreamPacket.fragment(STREAM, null, 0, 0, new byte[1]));
++        assertThrows(IllegalArgumentException.class,
++                () -> StreamPacket.fragment(STREAM, SESSION, -1, 0, new byte[1]));
++        assertThrows(IllegalArgumentException.class,
++                () -> StreamPacket.fragment(STREAM, SESSION, 0, -1, new byte[1]));
++    }
++
++    @Test void U07_fullArrayCannotHideTrailingBytesButExactMaxRegionIsValid() throws Exception {
++        byte[] wire = fixture("split-first");
++        byte[] backing = new byte[1219];
++        System.arraycopy(wire, 0, backing, 19, 1200);
++        assertThrows(ProtocolException.class, () -> StreamPacket.decode(backing));
++        assertEquals(1136, StreamPacket.decode(backing, 19, 1200).payload().length);
++        assertThrows(ProtocolException.class, () -> StreamPacket.decode(backing, 18, 1201));
++        assertThrows(ProtocolException.class, () -> StreamPacket.decode(null, 0, 65));
++        byte[] small = fixture("small");
++        byte[] extra = Arrays.copyOf(small, small.length + 1);
++        assertThrows(ProtocolException.class, () -> StreamPacket.decode(extra));
++        assertArrayEquals(new byte[]{0x41, 0x42, 0x43},
++                StreamPacket.decode(extra, 0, small.length).payload());
++    }
