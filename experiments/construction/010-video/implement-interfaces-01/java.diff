+/** Expectations come from the reviewed UDP fixtures/literal contract, never the codec. */
+class StreamPacketTest {
+    private static final UUID STREAM = UUID.fromString("00000000-0000-4000-8000-000000000001");
+    private static final UUID SESSION = UUID.fromString("deadbeef-0000-4000-8000-000000000001");
+    private static final Map<String, String> SHA = Map.ofEntries(
+            Map.entry("min", "529f908841a8fa954cf8d897a67c35825038fc4575999ca11982fbe7eae758e7"),
+            Map.entry("small", "240e54e0fa502e1bdaca540a4aedddf397278ffcc66730da47318609deef8dd5"),
+            Map.entry("split-first", "6e33e046c0f3fddfb9405983f063b2f81cba273f6adc5b51580b861b09b48ac6"),
+            Map.entry("split-last", "08cd13afeb0ef13bb8584500ef3d6c20d6a2fa79842eab9aeb2068b7b7bd05f1"),
+            Map.entry("invalid-short-header", "40d0960372611d87c68417a4f86c9799ab00ec5d9c74947d96364743be3c69dd"),
+            Map.entry("invalid-no-payload", "fd1a09c6f2b4c79f96e6b008056407203b2c15e9bf87340ab7683d557432460f"),
+            Map.entry("invalid-magic", "af011646b162bff90841d3f4810d97037aa0528a1a83ef429bec85daefc7bfe4"),
+            Map.entry("invalid-version", "af99bea7c893efe3a0c4e9ad0cf4a56fcf1dd895776112ab50b616c645b8665c"),
+            Map.entry("invalid-flags", "de4fbdadf40ad20fcbda07820b31d8deec564ac34432ee2cca5364e4910c14a8"),
+            Map.entry("invalid-header-length", "45af6d481162c8adf60491464631274a2f49363522767e5e8b64638387d9a170"),
+            Map.entry("invalid-index", "0704524abdc28afa9920419fe12174c0c2e3ca0235d5b4f6a6a015b8cef6b0ed"),
+            Map.entry("invalid-count", "31579b3668aa7b3e1fb9da5fe2d83a962ea109d981e3a970e288af15406a5340"),
+            Map.entry("invalid-zero-frame", "7693db6bf5adbc536989c6aa80bdc77017ddda0adaca801c69054a81d5375b06"),
+            Map.entry("invalid-large-frame", "7d28459ad8e0e993e13d9c2a748b5a60fedb742290064a4bba62c7221c92559b"),
+            Map.entry("invalid-negative-seq", "205c0369515375b03588724c076d214ecaffd4cf67a2559e31cbaf1aa6464ac1"),
+            Map.entry("invalid-datagram-size", "ea9bbe51a7d3aa91ea1b3848d4d14f128d8f7a303f38cbff024811ca5f65a3d0"));
+
+    private static byte[] resource(String name) throws Exception {
+        try (var input = StreamPacketTest.class.getResourceAsStream("/protocol/udp-" + name)) {
+            assertNotNull(input, "Independent resource must exist: " + name);
+            return input.readAllBytes();
+        }
+    }
+
+    private static byte[] fixture(String name) throws Exception {
+        byte[] bytes = resource(name + ".bin");
+        assertEquals(SHA.get(name), HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+        String hex = new String(resource(name + ".hex"), StandardCharsets.US_ASCII).replaceAll("\\s+", "");
+        assertArrayEquals(bytes, HexFormat.of().parseHex(hex));
+        return bytes;
+    }
+
+    private static byte[] repeated(int length, int value) {
+        byte[] bytes = new byte[length];
+        Arrays.fill(bytes, (byte) value);
+        return bytes;
+    }
+
+    private static StreamPacket packet(long seq, long time, long length, int index, int count, byte[] payload) {
+        return new StreamPacket(STREAM, SESSION, seq, time, length, index, count, payload);
+    }
+
+    static Stream<Arguments> goldenModels() {
+        return Stream.of(
+                Arguments.of("min", packet(0, 0, 1, 0, 1, new byte[]{(byte) 0xaa})),
+                Arguments.of("small", packet(7, 10000, 3, 0, 1, new byte[]{0x41, 0x42, 0x43})),
+                Arguments.of("split-first", packet(8, 40000, 1137, 0, 2, repeated(1136, 0xab))),
+                Arguments.of("split-last", packet(8, 40000, 1137, 1, 2, new byte[]{(byte) 0xcd})));
+    }
+
+    @Test void U01_independentFixtureFilesRemainIntact() throws Exception {
+        assertEquals(16, SHA.size());
+        for (String name : SHA.keySet()) fixture(name);
+    }
+
+    @ParameterizedTest(name = "U01 encode golden {0}") @MethodSource("goldenModels")
+    void U01_encoderMatchesGoldenBytes(String name, StreamPacket expected) throws Exception {
+        assertArrayEquals(fixture(name), assertDoesNotThrow(() -> StreamPacket.encode(expected)),
+                "encode must produce the independent golden bytes");
+    }
+
+    @ParameterizedTest(name = "U01 decode golden {0}") @MethodSource("goldenModels")
+    void U01_decoderMatchesGoldenFields(String name, StreamPacket expected) throws Exception {
+        assertPacket(expected, assertDoesNotThrow(() -> StreamPacket.decode(fixture(name))));
+    }
+
+    private static void assertPacket(StreamPacket expected, StreamPacket actual) {
+        assertNotNull(actual, "decode must return a packet, not an unwired interface placeholder");
+        assertEquals(expected.streamId(), actual.streamId());
+        assertEquals(expected.sessionId(), actual.sessionId());
+        assertEquals(expected.frameSeq(), actual.frameSeq());
+        assertEquals(expected.mediaTimeUs(), actual.mediaTimeUs());
+        assertEquals(expected.frameLength(), actual.frameLength());
+        assertEquals(expected.fragmentIndex(), actual.fragmentIndex());
+        assertEquals(expected.fragmentCount(), actual.fragmentCount());
+        assertArrayEquals(expected.payload(), actual.payload());
+    }
+
+    @ParameterizedTest @ValueSource(strings = {"short-header", "no-payload", "magic", "version", "flags",
+            "header-length", "index", "count", "zero-frame", "large-frame", "negative-seq", "datagram-size"})
+    void U02_decoderRejectsIndependentNegativeFixtures(String name) throws Exception {
+        byte[] bytes = fixture("invalid-" + name);
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(bytes));
+    }
+
+    @Test void U03_publicConstantsPreserveUdpAndSeparateTcpVersion() {
+        assertEquals(0x4f545431, StreamPacket.MAGIC);
+        assertEquals(1, StreamPacket.VERSION);
+        assertEquals(64, StreamPacket.HEADER_BYTES);
+        assertEquals(1200, StreamPacket.MAX_DATAGRAM_BYTES);
+        assertEquals(1136, StreamPacket.MAX_PAYLOAD_BYTES);
+        assertEquals(2097152, StreamPacket.MAX_FRAME_BYTES);
+        assertEquals(1847, StreamPacket.MAX_FRAGMENTS);
+        assertEquals(2, MessageCodec.VERSION);
+    }
+
+    // Literal bytes written from the offset table; no production writer is used.
+    private static byte[] literalGolden() {
+        return HexFormat.of().parseHex("4f54543101000040"
+                + "0123456789abcdeffedcba9876543210"
+                + "112233445566778899aabbccddeeff00"
+                + "0102030405060708" + "1112131415161718"
+                + "00000001" + "0000" + "0001" + "7e");
+    }
+
+    private static StreamPacket literalModel() {
+        return new StreamPacket(UUID.fromString("01234567-89ab-cdef-fedc-ba9876543210"),
+                UUID.fromString("11223344-5566-7788-99aa-bbccddeeff00"),
+                0x0102030405060708L, 0x1112131415161718L, 1, 0, 1, new byte[]{0x7e});
+    }
+
+    @Test void U03_encoderPreservesLiteralOffsetsAndUuidBits() throws Exception {
+        assertArrayEquals(literalGolden(), assertDoesNotThrow(() -> StreamPacket.encode(literalModel())));
+    }
+
+    @Test void U03_decoderPreservesLiteralOffsetsAndUuidBits() throws Exception {
+        assertPacket(literalModel(), assertDoesNotThrow(() -> StreamPacket.decode(literalGolden())));
+    }
+
+    @Test void U03_maximumNonnegativeCountersAreRepresentable() throws Exception {
+        byte[] bytes = literalGolden();
+        ByteBuffer.wrap(bytes).order(ByteOrder.BIG_ENDIAN).putLong(40, Long.MAX_VALUE).putLong(48, Long.MAX_VALUE);
+        var packet = assertDoesNotThrow(() -> StreamPacket.decode(bytes));
+        assertNotNull(packet, "decode behavior is required");
+        assertEquals(Long.MAX_VALUE, packet.frameSeq());
+        assertEquals(Long.MAX_VALUE, packet.mediaTimeUs());
+    }
+
+    private static byte[] frame(int length) {
+        byte[] bytes = new byte[length];
+        for (int i = 0; i < length; i++) bytes[i] = (byte) (i * 37 + 11);
+        return bytes;
+    }
+
+    @ParameterizedTest @ValueSource(ints = {1, 1135, 1136, 1137, 2272, 2273, 99999, 2097151, 2097152})
+    void U04_fragmentationHonorsBoundariesAndRecombinesExactly(int length) throws Exception {
+        byte[] original = frame(length);
+        List<StreamPacket> packets = assertDoesNotThrow(() -> StreamPacket.fragment(STREAM, SESSION, 9, 12345, original));
+        assertNotNull(packets);
+        int count = (length + 1135) / 1136;
+        assertEquals(count, packets.size(), "fragment must cover the complete input");
+        assertTrue(packets.size() <= 1847);
+        byte[] reconstructed = new byte[length];
+        int consumed = 0;
+        for (int i = 0; i < packets.size(); i++) {
+            StreamPacket packet = packets.get(i);
+            int bytes = Math.min(1136, length - consumed);
+            assertEquals(STREAM, packet.streamId());
+            assertEquals(SESSION, packet.sessionId());
+            assertEquals(9, packet.frameSeq());
+            assertEquals(12345, packet.mediaTimeUs());
+            assertEquals(length, packet.frameLength());
+            assertEquals(i, packet.fragmentIndex());
+            assertEquals(count, packet.fragmentCount());
+            assertArrayEquals(Arrays.copyOfRange(original, consumed, consumed + bytes), packet.payload());
+            byte[] wire = assertDoesNotThrow(() -> StreamPacket.encode(packet));
+            assertEquals(64 + bytes, wire.length);
+            assertTrue(wire.length <= 1200);
+            ByteBuffer header = ByteBuffer.wrap(wire).order(ByteOrder.BIG_ENDIAN);
+            assertEquals(0x4f545431, header.getInt(0));
+            assertEquals(1, Byte.toUnsignedInt(header.get(4)));
+            assertEquals(0, Byte.toUnsignedInt(header.get(5)));
+            assertEquals(64, Short.toUnsignedInt(header.getShort(6)));
+            assertEquals(STREAM.getMostSignificantBits(), header.getLong(8));
+            assertEquals(STREAM.getLeastSignificantBits(), header.getLong(16));
+            assertEquals(SESSION.getMostSignificantBits(), header.getLong(24));
+            assertEquals(SESSION.getLeastSignificantBits(), header.getLong(32));
+            assertEquals(9, header.getLong(40));
+            assertEquals(12345, header.getLong(48));
+            assertEquals(length, Integer.toUnsignedLong(header.getInt(56)));
+            assertEquals(i, Short.toUnsignedInt(header.getShort(60)));
+            assertEquals(count, Short.toUnsignedInt(header.getShort(62)));
+            System.arraycopy(wire, 64, reconstructed, consumed, bytes);
+            consumed += bytes;
+        }
+        assertEquals(length, consumed);
+        assertArrayEquals(original, reconstructed);
+        if (length == 2097152) assertEquals(96, packets.getLast().payload().length);
+    }
+
+    @ParameterizedTest @ValueSource(ints = {0, 2097153})
+    void U04_fragmentationRejectsFrameOutsideProtocolCap(int length) {
+        byte[] bytes = new byte[length];
+        assertThrows(IllegalArgumentException.class, () -> StreamPacket.fragment(STREAM, SESSION, 0, 0, bytes));
+    }
+
+    @Test void U05_split1137MatchesBothIndependentGoldenDatagrams() throws Exception {
+        byte[] original = repeated(1137, 0xab);
+        original[1136] = (byte) 0xcd;
+        var packets = assertDoesNotThrow(() -> StreamPacket.fragment(STREAM, SESSION, 8, 40000, original));
+        assertEquals(2, packets.size());
+        assertArrayEquals(fixture("split-first"), StreamPacket.encode(packets.getFirst()));
+        assertArrayEquals(fixture("split-last"), StreamPacket.encode(packets.getLast()));
+    }
+
+    static Stream<Arguments> hostileMetadata() {
+        return Stream.of(
+                Arguments.of("u32 high bit", 56, 4, 0x80000000L),
+                Arguments.of("u32 maximum", 56, 4, 0xffffffffL),
+                Arguments.of("u32 signed maximum", 56, 4, 0x7fffffffL),
+                Arguments.of("negative media time", 48, 8, -1L),
+                Arguments.of("minimum negative sequence", 40, 8, Long.MIN_VALUE),
+                Arguments.of("unsigned count maximum", 62, 2, 65535L),
+                Arguments.of("unsigned index maximum", 60, 2, 65535L),
+                Arguments.of("header u16 maximum", 6, 2, 65535L),
+                Arguments.of("high reserved flag", 5, 1, 128L));
+    }
+
+    @ParameterizedTest(name = "U06 {0}") @MethodSource("hostileMetadata")
+    void U06_forgedMetadataIsRejectedWithoutUsingItAsAnAllocationSize(String label, int offset, int width, long value)
+            throws Exception {
+        byte[] bytes = fixture("min");
+        ByteBuffer b = ByteBuffer.wrap(bytes).order(ByteOrder.BIG_ENDIAN);
+        if (width == 8) b.putLong(offset, value);
+        else if (width == 4) b.putInt(offset, (int) value);
+        else if (width == 2) b.putShort(offset, (short) value);
+        else b.put(offset, (byte) value);
+        assertEquals(65, bytes.length);
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(bytes), label);
+    }
+
+    @Test void U06_payloadTrailingByteIsNotIgnored() throws Exception {
+        byte[] bytes = Arrays.copyOf(fixture("min"), 66);
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(bytes));
+    }
+
+    static Stream<Arguments> invalidValues() {
+        return Stream.of(
+                Arguments.of(0L, 0, 1, 0L, 0L, 1),
+                Arguments.of(2097153L, 0, 1, 0L, 0L, 1),
+                Arguments.of(4294967295L, 0, 1, 0L, 0L, 1),
+                Arguments.of(Long.MAX_VALUE, 0, 1, 0L, 0L, 1),
+                Arguments.of(1L, 1, 1, 0L, 0L, 1),
+                Arguments.of(1L, 0, 0, 0L, 0L, 1),
+                Arguments.of(1L, 0, 2, 0L, 0L, 1),
+                Arguments.of(1L, 0, 1, -1L, 0L, 1),
+                Arguments.of(1L, 0, 1, 0L, -1L, 1),
+                Arguments.of(1L, 0, 1, 0L, 0L, 0),
+                Arguments.of(1L, 0, 1, 0L, 0L, 1137),
+                Arguments.of(1137L, 0, 2, 0L, 0L, 1135),
+                Arguments.of(1137L, 1, 2, 0L, 0L, 2),
+                Arguments.of(2272L, 1, 2, 0L, 0L, 1135));
+    }
+
+    @ParameterizedTest @MethodSource("invalidValues")
+    void U06_valueRejectsInvalidMetadataBeforeCopy(long length, int index, int count, long seq, long time, int payloadSize) {
+        byte[] payload = new byte[payloadSize];
+        assertThrows(IllegalArgumentException.class, () -> packet(seq, time, length, index, count, payload));
