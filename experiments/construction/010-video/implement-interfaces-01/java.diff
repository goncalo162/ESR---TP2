+
+    @Test void U07_absentDatagramIsAFormatError() {
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(null));
+    }
+
+    @Test void U08_valueCopiesInputPayload() {
+        byte[] input = {(byte) 0xaa};
+        StreamPacket value = packet(0, 0, 1, 0, 1, input);
+        input[0] = 0;
+        assertArrayEquals(new byte[]{(byte) 0xaa}, value.payload());
+    }
+
+    @Test void U08_valueDoesNotExposeMutablePayload() {
+        StreamPacket value = packet(0, 0, 1, 0, 1, new byte[]{(byte) 0xaa});
+        value.payload()[0] = 0;
+        assertArrayEquals(new byte[]{(byte) 0xaa}, value.payload());
+    }
+
+    @Test void U08_decoderOwnsPayloadAfterReceiveBufferReuse() throws Exception {
+        byte[] input = fixture("small");
+        StreamPacket packet = assertDoesNotThrow(() -> StreamPacket.decode(input));
+        assertNotNull(packet, "decode behavior is required before ownership can be verified");
+        input[64] = 0;
+        assertArrayEquals(new byte[]{0x41, 0x42, 0x43}, packet.payload());
+    }
+
+    @Test void U08_fragmentationOwnsPayloadAndReturnsImmutableList() {
+        byte[] original = {(byte) 0xaa};
+        List<StreamPacket> packets = StreamPacket.fragment(STREAM, SESSION, 0, 0, original);
+        assertEquals(1, packets.size());
+        original[0] = 0;
+        assertArrayEquals(new byte[]{(byte) 0xaa}, packets.getFirst().payload());
+        assertThrows(UnsupportedOperationException.class, () -> packets.add(packets.getFirst()));
+    }
+}
