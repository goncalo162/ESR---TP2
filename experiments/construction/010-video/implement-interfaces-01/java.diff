+
+    @Test void U06_encoderRejectsAbsentValue() {
+        assertThrows(ProtocolException.class, () -> StreamPacket.encode(null));
+    }
+
+    @Test void U07_sliceDecodesOnlyItsRegionWithoutMutatingInput() throws Exception {
+        byte[] wire = fixture("small");
+        byte[] backing = repeated(1400, 0x5a);
+        System.arraycopy(wire, 0, backing, 17, wire.length);
+        byte[] before = backing.clone();
+        var packet = assertDoesNotThrow(() -> StreamPacket.decode(backing, 17, wire.length));
+        assertPacket(packet(7, 10000, 3, 0, 1, new byte[]{0x41, 0x42, 0x43}), packet);
+        assertArrayEquals(before, backing);
+    }
+
+    static Stream<Arguments> invalidRegions() {
+        return Stream.of(Arguments.of(-1, 65), Arguments.of(0, -1), Arguments.of(65, 1),
