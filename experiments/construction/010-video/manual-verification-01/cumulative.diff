+        var packet = assertDoesNotThrow(() -> StreamPacket.decode(backing, 17, wire.length));
+        assertPacket(packet(7, 10000, 3, 0, 1, new byte[]{0x41, 0x42, 0x43}), packet);
+        assertArrayEquals(before, backing);
+    }
