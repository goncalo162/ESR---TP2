+        assertThrows(IllegalArgumentException.class, () -> packet(0, 0, 1, 0, 1, null));
+        assertThrows(IllegalArgumentException.class,
+                () -> StreamPacket.fragment(STREAM, SESSION, 0, 0, null));
+        assertThrows(IllegalArgumentException.class,
