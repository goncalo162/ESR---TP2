+    }
+
+    @Test void U08_decoderOwnsPayloadAfterReceiveBufferReuse() throws Exception {
+        byte[] input = fixture("small");
+        StreamPacket packet = assertDoesNotThrow(() -> StreamPacket.decode(input));
+        assertNotNull(packet, "decode behavior is required before ownership can be verified");
+        input[64] = 0;
