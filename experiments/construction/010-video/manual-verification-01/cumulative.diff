+                Arguments.of(1, 65), Arguments.of(Integer.MAX_VALUE, 1),
+                Arguments.of(1, Integer.MAX_VALUE), Arguments.of(Integer.MIN_VALUE, 65), Arguments.of(0, 64));
+    }
