+    @ParameterizedTest @MethodSource("invalidRegions")
+    void U07_invalidRegionCannotOverflowIntoAValidRange(int offset, int length) throws Exception {
+        byte[] bytes = fixture("min");
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(bytes, offset, length));
+    }
+
+    @Test void U07_absentDatagramIsAFormatError() {
+        assertThrows(ProtocolException.class, () -> StreamPacket.decode(null));
+    }
+
+    @Test void U08_valueCopiesInputPayload() {
+        byte[] input = {(byte) 0xaa};
+        StreamPacket value = packet(0, 0, 1, 0, 1, input);
+        input[0] = 0;
+        assertArrayEquals(new byte[]{(byte) 0xaa}, value.payload());
+    }
+
+    @Test void U08_valueDoesNotExposeMutablePayload() {
+        StreamPacket value = packet(0, 0, 1, 0, 1, new byte[]{(byte) 0xaa});
+        value.payload()[0] = 0;
