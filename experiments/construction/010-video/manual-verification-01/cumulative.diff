+
+    @Test void U08_fragmentationOwnsPayloadAndReturnsImmutableList() {
+        byte[] original = {(byte) 0xaa};
+        List<StreamPacket> packets = StreamPacket.fragment(STREAM, SESSION, 0, 0, original);
+        assertEquals(1, packets.size());
