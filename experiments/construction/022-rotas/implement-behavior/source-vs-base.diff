+            for(var node:List.of(source,a,b,client))node.until(t->t.lines().filter(l->l.contains("NeighborUp[")).count()>=2);
+            client.until(t->t.contains("STREAM_ANNOUNCE")&&t.contains("PROBE_PONG"));
+            long began=System.nanoTime();
+            while(true) {
+                int offset=client.text().length();client.send("routes");client.until(t->t.substring(Math.min(offset,t.length())).contains("ROUTES_END"));
+                if(client.text().substring(offset).contains("state=INACTIVE"))break;
+                assertTrue(System.nanoTime()-began<java.util.concurrent.TimeUnit.SECONDS.toNanos(8));Thread.sleep(50);
+            }
+            signal(source,"STOP");
+            try {
+                int ao=a.text().length(),bo=b.text().length(),co=client.text().length();client.send("trace "+CliGraph.VIDEO);
+                long waiting=System.nanoTime();CliProcess selected=null;
+                while(selected==null) {
+                    if(a.text().substring(ao).contains("direction=request"))selected=a;
+                    else if(b.text().substring(bo).contains("direction=request"))selected=b;
