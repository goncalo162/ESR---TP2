+        RealIo(int maximum, AddressLookup lookup) {
+            this.maximum = maximum;
+            this.lookup = Objects.requireNonNull(lookup);
+            worker = new ThreadPoolExecutor(1, 1, 0, TimeUnit.MILLISECONDS, new ArrayBlockingQueue<>(maximum),
