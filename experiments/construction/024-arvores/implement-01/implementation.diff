+@Timeout(25)
+class RouteSwitchTest
+{
+    //* === Atributos e Variáveis === *
+    private static final long SECOND = 1_000_000_000L;
+
+
+
+    //* === Auxiliar === *
+
+    private static final class Rig implements AutoCloseable
+    {
+        //* === Atributos e Variáveis === *
+        final AtomicLong clock = new AtomicLong();
+        final Owner owner = new Owner(4096);
+        final Timers timers = new Timers(clock);
+        final List<Sent> sent = new ArrayList<>();
+        final List<RoutingService.SwitchEvent> events = new ArrayList<>();
+        final Neighbor.Session a = peer("A"), b = peer("B");
+        final Map<Neighbor.Session,Long> samples = new HashMap<>();
+        final RoutingService router;
+        Predicate<ControlMessage> hold = message -> false;
+        Consumer<RoutingService.Event> sink = event -> { };
+        RoutingService.SubscriptionTicket ticket;
+
+
+
+        //* === Construtores === *
+
+        Rig()
+        {
+            router = new RoutingService(config("R", false, 4096, 3), id("R-instance"), owner, (session, message) -> {
+                assertTrue(owner.isOwnerThread());
+                if(message.type() == MessageType.DEACTIVATE && !events.isEmpty()
+                        && events.getLast().phase() == RoutingService.SwitchPhase.SUCCESS)
+                    assertEquals(events.getLast().replacement(), forwarding().upstream().orElseThrow());
+                var result = new CompletableFuture<Connection.SendResult>();
+                sent.add(new Sent(session, message, result));
+                if(!hold.test(message))
+                    result.complete(Connection.SendResult.ACCEPTED);
+                return result;
+            }, event -> {
+                assertFalse(event.fatal(), event.toString());
+                event.routeSwitch().ifPresent(change -> {
+                    if(change.phase() == RoutingService.SwitchPhase.SUCCESS)
+                        assertEquals(change.replacement(), forwarding().upstream().orElseThrow());
+                    events.add(change);
+                });
+                sink.accept(event);
+            }, clock::get, timers);
+            act(router::start);
+            up(a);
+            metric(a, 10);
+            ad(a, 1, 990);
+            ticket = router.requestSubscription(A, id("consumer"));
+            pump();
+            ack(latest(), 6000);
+            assertEquals(a, forwarding().upstream().orElseThrow());
+        }
+
+
+
+        //* === Lógica === *
+
+        void act(Runnable action)
+        {
+            owner.run(action);
+            pump();
+        }
+
+
+        void pump()
+        {
+            for(int i = 0; i < 10000; i++)
+            {
+                boolean work = owner.drain();
+                boolean alarm = timers.fire();
+                if(!work && !alarm)
+                    return;
+            }
+            fail("Unbounded quality wake loop");
+        }
+
+
+        void tick(long nanos)
+        {
+            clock.addAndGet(nanos);
+            pump();
+        }
+
+
+        void up(Neighbor.Session session)
+        {
+            act(() -> router.onNeighborEvent(new NeighborManager.NeighborUp(session)));
+        }
+
+
+        void sample(Neighbor.Session session, long cost, long count, long at, boolean saturated)
+        {
+            act(() -> router.onMetrics(new NetworkMonitor.Updated(new LinkMetrics(session,
+                    LinkMetrics.State.MEASURED, OptionalDouble.of(cost), OptionalLong.of(cost), count,
+                    saturated, OptionalLong.of(at), 0))));
+        }
+
+
+        void metric(Neighbor.Session session, long cost)
+        {
+            sample(session, cost, samples.merge(session, 1L, Long::sum), clock.get(), false);
+        }
+
+
+        void receive(Neighbor.Session session, ControlMessage message)
+        {
+            act(() -> router.onNeighborEvent(new NeighborManager.Received(session, message)));
+        }
+
+
+        void ad(Neighbor.Session session, long generation, long cost)
+        {
+            receive(session, new ControlMessage(MessageType.STREAM_ANNOUNCE, UUID.randomUUID(), session.nodeId(),
+                    session.instanceId(), new ControlMessage.Announcement(new ControlMessage.StreamInfo(A, "S",
+                        "Video", 1, 10, EPOCH), generation, cost, List.of("S", session.nodeId()))));
+        }
+
+
+        void alternative(long advertised)
+        {
+            up(b);
+            metric(b, 10);
+            ad(b, 1, advertised);
+        }
+
+
+        void qualify()
+        {
+            alternative(790);
+            metric(b, 10);
+            metric(b, 10);
+        }
+
+
+        void longGrant()
+        {
+            tick(4 * SECOND);
+            ack(messages(MessageType.SUBSCRIPTION_RENEW).getLast(), 6000);
+            ad(a, 2, 990);
+        }
+
+
+        List<Sent> messages(MessageType type)
+        {
+            return sent.stream().filter(value -> value.message().type() == type).toList();
+        }
+
+
+        Sent latest()
+        {
+            return messages(MessageType.ACTIVATE).getLast();
+        }
+
+
+        void ack(Sent request, long lease)
+        {
+            var payload = (ControlMessage.Activation) request.message().payload();
+            receive(request.peer(), new ControlMessage(MessageType.ACTIVATE_ACK, request.message().requestId(),
+                    request.peer().nodeId(), request.peer().instanceId(), new ControlMessage.ActivationAck(
+                        payload.streamId(), payload.serverEpoch(), payload.subscriptionId(), payload.revision(), lease)));
+        }
+
+
+        void reject(Sent request)
+        {
+            receive(request.peer(), new ControlMessage(MessageType.ERROR, request.message().requestId(),
+                    request.peer().nodeId(), request.peer().instanceId(),
+                    new ControlMessage.ErrorPayload(ErrorCode.NO_ROUTE, 11, "NO_ROUTE")));
+        }
+
+
+        Route.Confirmation forwarding()
+        {
+            return router.snapshot().forwarding().get(A);
+        }
+
+
+        RoutingService.ActivationLoad load()
+        {
+            var load = new AtomicReference<RoutingService.ActivationLoad>();
+            owner.run(() -> load.set(router.activationLoad()));
+            return load.get();
+        }
+
+
+        public void close()
+        {
+            router.requestClose();
+            owner.drain();
+            for(var send : sent)
+            {
+                send.result().complete(Connection.SendResult.CLOSED);
+            }
+            owner.drain();
+            assertTrue(router.awaitTermination(Duration.ofSeconds(1)));
+            owner.close();
+        }
+    }
