+    private static final class ApplicationHarness implements AutoCloseable
+    {
+        //* === Atributos e Variáveis === *
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        final List<String> writers = new CopyOnWriteArrayList<>();
+        final Object console;
+        final AutoCloseable service;
+        final OverlayNode node;
+        final RoutingService router;
+        final NeighborManager.SerialOwner owner;
+        final Thread writer;
+        final AtomicBoolean outputStopping;
+
+
+
+        //* === Construtores === *
+
+        ApplicationHarness(NodeConfiguration config, boolean startWriter) throws Exception
+        {
+            var consoleClass = Class.forName(OttApplication.class.getName() + "$Console");
+            var constructor = consoleClass.getDeclaredConstructor(InputStream.class, PrintStream.class, PrintStream.class,
+                    NodeConfiguration.class, LongSupplier.class);
+            constructor.setAccessible(true);
+            var output = new PrintStream(bytes, true, java.nio.charset.StandardCharsets.UTF_8)
+            {
+                public void println(String text)
+                {
+                    writers.add(Thread.currentThread().getName());
+                    super.println(text);
+                }
+            };
+            console = constructor.newInstance(InputStream.nullInputStream(), output, output, config,
+                    (LongSupplier) System::nanoTime);
+            writer = (Thread) field(console, "writer");
+            outputStopping = (AtomicBoolean) field(console, "outputStopping");
+            if(startWriter)
+                writer.start();
+            var open = OttApplication.class.getDeclaredMethod("open", NodeConfiguration.class, consoleClass);
+            open.setAccessible(true);
+            service = (AutoCloseable) open.invoke(null, config, console);
+            var captured = Arrays.stream(service.getClass().getDeclaredFields())
+                    .filter(value -> value.getType() == OverlayNode.class).findFirst().orElseThrow();
+            captured.setAccessible(true);
+            node = (OverlayNode) captured.get(service);
+            await(() -> node.routingSnapshot().diagnostics().phase() == RoutingService.Phase.RUNNING);
+            router = (RoutingService) field(node, "routing");
+            owner = (NeighborManager.SerialOwner) field(node, "owner");
+        }
+
+
+
+        //* === Lógica === *
+
+        String output()
+        {
+            return bytes.toString(java.nio.charset.StandardCharsets.UTF_8);
+        }
+
+
+        void act(Runnable action) throws Exception
+        {
+            var done = new CompletableFuture<Void>();
+            assertTrue(owner.offer(() -> {
+                try
+                {
+                    action.run();
+                    done.complete(null);
+
+                }catch(Throwable error){
+                    done.completeExceptionally(error);
+                }
+            }));
+            done.get(5, TimeUnit.SECONDS);
+        }
+
+
+        public void close() throws Exception
+        {
+            try
+            {
+                service.close();
+
+            }finally{
+                outputStopping.set(true);
+                if(writer.getState() != Thread.State.NEW)
+                {
+                    writer.join(5000);
+                    assertFalse(writer.isAlive());
+                }
+            }
+        }
+    }
+
